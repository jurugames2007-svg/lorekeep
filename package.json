{
  "name": "lorevinci-desktop",
  "version": "1.0.0",
  "description": "LoreVinci - Escritorio de escritura creativa con asistente de IA (Muse AI)",
  "main": "main.js",
  "author": "LoreVinci",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "preview": "python3 -m http.server 3000 --directory renderer",
    "dist": "electron-builder",
    "test": "node tests/run-all.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lorevinci.app",
    "productName": "LoreVinci",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}